{$TLS_DOMAIN} {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    request_body {
        max_size 300KB
    }
    header {
        -Server
        X-Content-Type-Options nosniff
    }
    @administrator path /v1/admin/*
    respond @administrator 404
    reverse_proxy app:8080
    log {
        output stdout
        format json
    }
}
