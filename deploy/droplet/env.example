# Copy to /opt/notification-fanout/.env on the Droplet, chmod 600.
# Generate each secret independently with: openssl rand -hex 32
PG_OWNER_PASSWORD=REPLACE_WITH_RANDOM_HEX
DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
ADMIN_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_HEX
API_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_HEX
WEBHOOK_SIGNING_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_HEX
WEBHOOK_ORIGINS=["https://hooks.example.com"]
# Leave blank for SSH-tunnel-only access; set after DNS points at this Droplet.
TLS_DOMAIN=
