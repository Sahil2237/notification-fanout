[Unit]
Description=Daily encrypted PostgreSQL backup and 24-hour Spaces retention
After=docker.service network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/notification-spaces-backup
TimeoutStartSec=1800
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
