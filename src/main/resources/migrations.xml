    <sql splitStatements="false"><![CDATA[
      DO $grant$ BEGIN
        IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname='notification_runtime') THEN
          GRANT SELECT,INSERT,UPDATE,DELETE ON fixed_window_limits,delivery_dead_letters TO notification_runtime;
        END IF;
      END $grant$;
    ]]></sql>
